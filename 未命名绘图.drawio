        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;%%{init: {\n  &#39;theme&#39;: &#39;base&#39;,\n  &#39;themeVariables&#39;: {\n    &#39;primaryColor&#39;: &#39;#ffffff&#39;,\n    &#39;primaryBorderColor&#39;: &#39;#333333&#39;,\n    &#39;primaryTextColor&#39;: &#39;#212121&#39;,\n    &#39;lineColor&#39;: &#39;#455A64&#39;,\n    &#39;fontSize&#39;: &#39;13px&#39;,\n    &#39;fontFamily&#39;: &#39;Microsoft YaHei, SimHei, sans-serif&#39;\n  },\n  &#39;flowchart&#39;: {\n    &#39;curve&#39;: &#39;basis&#39;,\n    &#39;nodeSpacing&#39;: 28,\n    &#39;rankSpacing&#39;: 38,\n    &#39;useMaxWidth&#39;: false\n  }\n}}%%\nflowchart TD\n    %% 阶段一：发布与审核\n    START((开始)) --&gt; PUB[\&quot;机构 / 园区 / 企业发起发布&lt;br/&gt;【问卷、活动、政策、需求】同级入口\&quot;]\n    PUB --&gt; AUDIT{\&quot;内部审核&lt;br/&gt;是否通过\&quot;}\n    \n    AUDIT --&gt;|否| BACK1[\&quot;退回修改 / 终止\&quot;]\n    BACK1 --&gt;|重新提交| PUB\n    BACK1 --&gt;|终止| OUT1([\&quot;输出 发布作废&lt;br/&gt;不对外触达\&quot;])\n    \n    AUDIT --&gt;|是| PORTAL{\&quot;是否发布&lt;br/&gt;到门户？\&quot;}\n    \n    PORTAL --&gt;|分类群发| INNER[\&quot;【分类群发】定向发布上线\&quot;]\n    PORTAL --&gt;|一键发送| PLAT{\&quot;平台审核&lt;br/&gt;防乱写 / 合规\&quot;}\n    \n    PLAT --&gt;|否| BACK2[\&quot;退回修改 / 终止\&quot;]\n    BACK2 --&gt;|重新提交| PUB\n    BACK2 --&gt;|终止| OUT2([\&quot;输出 发布作废&lt;br/&gt;不对外触达\&quot;])\n    PLAT --&gt;|是| OUTER[\&quot;【一键发送】对外门户发布上线\&quot;]\n\n    %% 阶段二：类型分流\n    INNER --&gt; SPLIT[\&quot;已上线内容按类型分流（含分类群发）\&quot;]\n    OUTER --&gt; SPLIT\n\n    %% 三条平行互动流\n    SPLIT --&gt;|活动| A1[\&quot;企业线上报名\&quot;]\n    A1 --&gt; A2([\&quot;输出到【客户公海池】&lt;br/&gt;销售管理接收\&quot;])\n    A2 --&gt; A3[\&quot;线下 / 线上参会\&quot;]\n    A3 --&gt; A4[\&quot;【活动培训圆满结束】\&quot;]\n    A4 --&gt; A5[\&quot;推送活动满意度问卷\&quot;]\n    A5 --&gt; A6{\&quot;满意度 / 潜力&lt;br/&gt;是否达标\&quot;}\n    A6 --&gt;|否| A7([\&quot;输出 活动档案归档&lt;br/&gt;不进需求收集表\&quot;])\n\n    SPLIT --&gt;|政策| B1[\&quot;企业查阅政策推送\&quot;]\n    B1 --&gt; B2[\&quot;【点击感兴趣】&lt;br/&gt;弹出专属资质申报问卷\&quot;]\n    B2 --&gt; B3[\&quot;企业提交申报问卷\&quot;]\n    B3 --&gt; B4{\&quot;资质是否符合\&quot;}\n    B4 --&gt;|否| B5([\&quot;输出 留存浏览记录&lt;br/&gt;不进需求收集表\&quot;])\n\n    SPLIT --&gt;|问卷| C1[\&quot;独立问卷上线\&quot;]\n    C1 --&gt; C2[\&quot;企业主动填写常规问卷\&quot;]\n    C2 --&gt; C3{\&quot;质量与需求&lt;br/&gt;是否达标\&quot;}\n    C3 --&gt;|否| C4([\&quot;输出 数据归档入库&lt;br/&gt;不进需求收集表\&quot;])\n\n    %% 阶段三：归集与分发\n    SPLIT -.-&gt;|已发布需求| TBL\n    A6 --&gt;|是| TBL[\&quot;【需求收集表】三路达标与已发布需求统一沉淀\&quot;]\n    B4 --&gt;|是| TBL\n    C3 --&gt;|是| TBL\n\n    TBL --&gt; OP[\&quot;操作员核实，点击【转线索】&lt;br/&gt;生成正式销售线索\&quot;]\n    OP --&gt; OPP{\&quot;是否形成明确&lt;br/&gt;商机 / 线索\&quot;}\n    \n    OPP --&gt;|否| REC([\&quot;输出 沉淀常规客情记录&lt;br/&gt;不转销售\&quot;])\n    OPP --&gt;|是| CAP{\&quot;本机构自身&lt;br/&gt;能否承接？\&quot;}\n    \n    CAP --&gt;|能承接| LEAD[\&quot;点击【分发线索】&lt;br/&gt;【转入线索客户模块】派发销售跟进\&quot;]\n    LEAD --&gt; PROG[\&quot;线索进度回写需求收集表&lt;br/&gt;合同签订 / 实施 / 回款 / 结案完结\&quot;]\n    PROG -.-&gt;|进度回写| TBL\n    \n    CAP --&gt;|不能承接| OVER[\&quot;转为平台外溢需求\&quot;]\n\n    %% 阶段四：外溢撮合\n    OVER --&gt; DIST[\&quot;发起需求分发\&quot;]\n    DIST --&gt; MA[\&quot;模式 A: 分类群发&lt;br/&gt;按行业 / 标签定向推送\&quot;]\n    DIST --&gt; MB[\&quot;模式 B: 一键发送&lt;br/&gt;全平台广播推送\&quot;]\n    \n    MA --&gt; HOME[\&quot;【被选企业后台首页】醒目展示需求\&quot;]\n    MB --&gt; HOME\n    HOME --&gt; CLAIM[\&quot;目标企业查看并认领\&quot;]\n    CLAIM --&gt; CALL[\&quot;系统开放双方联系方式，电话沟通\&quot;]\n    CALL --&gt; MATCH{\&quot;撮合结果\&quot;}\n    \n    MATCH --&gt;|完成| OK([\&quot;撮合完成&lt;br/&gt;外溢进度回写需求收集表\&quot;])\n    OK -.-&gt;|进度回写| TBL\n    MATCH --&gt;|失败| FAIL([\&quot;撮合失败&lt;br/&gt;需求留存，可再次分发\&quot;])\n    FAIL --&gt; OVER\n\n    %% 节点样式（完全对齐文档）\n    classDef default fill:#FFFFFF,stroke:#37474F,stroke-width:1.2px;\n    classDef keyAction fill:#FFF9C4,stroke:#FBC02D,stroke-width:1.5px,color:#000000;\n    classDef tableNode fill:#E1F5FE,stroke:#0288D1,stroke-width:1.8px,color:#01579B;\n    classDef outNode fill:#E8F5E9,stroke:#388E3C,stroke-width:1.2px,color:#1B5E20;\n    classDef rejectNode fill:#FFEBEE,stroke:#E53935,stroke-width:1.2px,color:#B71C1C;\n\n    class INNER,OUTER,A4,B2,HOME,OP,LEAD,OVER keyAction;\n    class TBL tableNode;\n    class A2,A7,B5,C4,REC,OK,FAIL outNode;\n    class OUT1,OUT2,BACK1,BACK2 rejectNode;&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="DZkHSx2JtszpbjkErmXV-100">
